---
import ToggleDarkMode from "../ToggleDarkMode.astro";
import "./navbar.css";
---

<nav class="navbar-shell" aria-label="Navegación principal">
  <div class="navbar">
    <a href="#" class="navbar-brand" aria-label="LainerDev, inicio">
      <span><span class="navbar-text__dev">Lainer</span>Dev</span>
    </a>

    <ul class="navbar-link" id="primary-navigation">
      <li><a href="#">Inicio</a></li>
      <li><a href="#about">Sobre mí</a></li>
      <li><a href="#projects">Proyectos</a></li>
      <li><a href="#stack">Habilidades</a></li>
      <li><a href="#education">Educación</a></li>
    </ul>
    <div class="navbar-actions">
      <a
        target="_blank"
        href="https://wa.me/573146486981"
        class="btn-primary navbar-button">Hablemos</a
      >
      <button
        class="navbar-btn-hamburguer"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="primary-navigation"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-menu-icon lucide-menu"
          ><path d="M4 5h16"></path><path d="M4 12h16"></path><path d="M4 19h16"
          ></path>
        </svg>
      </button>
      <ToggleDarkMode />
    </div>
  </div>
  <div class="navbar-overlay"></div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const navbarBtnHamburguer = document.querySelector(
        ".navbar-btn-hamburguer",
      );

      const navbarLink = document.querySelector(".navbar-link");
      const allLinks = document.querySelectorAll(".navbar-link li a");
      const overlay = document.querySelector(".navbar-overlay");

      navbarBtnHamburguer?.addEventListener("click", () => {
        const isOpen = navbarLink?.classList.toggle("active") ?? false;
        overlay?.classList.toggle("active", isOpen);
        navbarBtnHamburguer.setAttribute("aria-expanded", String(isOpen));
      });

      allLinks.forEach((link) => {
        link.addEventListener("click", () => {
          navbarLink?.classList.remove("active");
          overlay?.classList.remove("active");
          navbarBtnHamburguer?.setAttribute("aria-expanded", "false");
        });
      });

      overlay?.addEventListener("click", () => {
        navbarLink?.classList.remove("active");
        overlay.classList.remove("active");
        navbarBtnHamburguer?.setAttribute("aria-expanded", "false");
      });
    });
  </script>
</nav>
