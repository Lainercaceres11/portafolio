---
import "./banner.css";
---

<header>
  <div class="banner">
    <div class="banner-content">
      <span class="banner-title">Desarrollador Front-End</span>
      <h1 class="banner-subtitle">
        Diseño y desarrollo de <span>experiencias digitales</span> que conectan
      </h1>
      <p class="banner-description">
        Creo interfaces web modernas, accesibles y de alto rendimiento. Me
        gusta convertir ideas en productos digitales claros, útiles y agradables
        de usar.
      </p>

      <div class="banner-actions">
        <a href="#projects" class="btn-primary">Ver proyectos</a>
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="/documents/cv.pdf"
          class="btn-primary btn-cv">Ver CV</a
        >
      </div>
      <p class="banner-note"><span></span> Interfaces útiles, accesibles y cuidadas</p>
    </div>

    <div class="banner-visual" aria-hidden="true">
      <div class="visual-orbit visual-orbit--outer"></div>
      <div class="visual-orbit visual-orbit--inner"></div>
      <div class="visual-card">
        <div class="visual-card__top">
          <span class="visual-dots"><i></i><i></i><i></i></span>
          <span>lainer.dev</span>
        </div>
        <div class="visual-card__body">
          <span class="visual-card__eyebrow">Construyendo para las personas</span>
          <div class="visual-card__monogram">LC<span>.</span></div>
          <div class="visual-card__rule"></div>
          <div class="visual-card__tags">
            <span>UI cuidada</span>
            <span>Código limpio</span>
            <span>Experiencias web</span>
          </div>
        </div>
      </div>
      <span class="visual-spark visual-spark--one">✳</span>
      <span class="visual-spark visual-spark--two">✦</span>
    </div>
  </div>
</header>
